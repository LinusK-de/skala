# Normalize line endings across machines (Windows dev, macOS release).
# Text files are stored as LF in the repo and checked out as LF everywhere.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.p8 binary
*.p12 binary
*.jks binary
